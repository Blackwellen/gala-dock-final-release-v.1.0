# Automatic HTTPS (Let's Encrypt) for the three ops hostnames. Point their DNS A records at the VM's public IP first.
{$SCAN_HOST} {
	reverse_proxy av-scanner:8080
	request_body {
		max_size 26MB
	}
}

{$STATUS_HOST} {
	reverse_proxy uptime-kuma:3001
}

{$ERRORS_HOST} {
	reverse_proxy glitchtip-web:8000
}
