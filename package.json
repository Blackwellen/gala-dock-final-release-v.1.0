{
  "name": "gala-dock-final-release",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "supabase:check": "node --env-file=.env.local scripts/supabase-check.mjs",
    "supabase:types": "node --env-file=.env --env-file=.env.local scripts/supabase-types.mjs",
    "db:status": "node --env-file=.env --env-file=.env.local scripts/db/migrate.mjs status",
    "db:parity": "node --env-file=.env --env-file=.env.local scripts/db/migrate.mjs parity",
    "db:lint": "node scripts/db/migrate.mjs lint --pending",
    "db:migrate": "node --env-file=.env --env-file=.env.local scripts/db/migrate.mjs",
    "release:supply-chain": "node scripts/release/supply-chain.mjs",
    "release:check": "npm run lint && node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit -p . && npm run release:supply-chain && npm run db:parity"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
