NEXT_PUBLIC_SUPABASE_URL=https://sgonzfolwjlcaiggrbbj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=sgonzfolwjlcaiggrbbj
# Management scripts only. Keep the PAT in .env, never in browser code.
SUPABASE_PAT_KEY=

# Two-way calendar sync (optional). Without these, Calendar → Connect falls back to the private ICS subscription link.
# Redirect URIs to register: <site>/api/calendar/oauth/google/callback and <site>/api/calendar/oauth/microsoft/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Optional: tenant id to restrict Microsoft sign-in (default "common").
MICROSOFT_CALENDAR_TENANT=
# 32-byte key (hex or base64) for encrypting stored calendar tokens. Falls back to a key derived from the service role key.
CALENDAR_TOKEN_KEY=
