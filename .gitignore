# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-pwa-release/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# session states from automated sign-in (contain auth tokens)
/artifacts/auth/
/artifacts/visual/state-*.json

# Playwright output (traces can contain session tokens)
/test-results/
/playwright-report/
/blob-report/
/artifacts/debug/
/artifacts/pwa/test-*/
/artifacts/pwa/**/trace.zip
/artifacts/pwa/traces/

.vercel
/artifacts/tmp/
/.next-pwa-maximum/
